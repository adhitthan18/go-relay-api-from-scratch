# Environment dan kredensial
.env
cookies.txt

# Semua JSON di folder utama adalah berkas kerja curl atau NVS simulator —
# keduanya memuat token atau password. Garis miring di depan membatasi pola
# ini hanya ke folder teratas, jadi ui/package.json tidak terpengaruh.
/*.json

# Hasil build
ui/node_modules/
# ui/dist/.gitkeep tetap di-commit: //go:embed all:ui/dist gagal dikompilasi
# kalau foldernya tidak ada, jadi clone baru harus bisa `go test` tanpa
# membangun UI dulu. Vite mengosongkan dist/ setiap build lalu menyalin ulang
# penanda itu dari ui/public/.gitkeep.
ui/dist/*
!ui/dist/.gitkeep
belajar-relay.tar.gz
*.tar.gz

# Binary
/relay
/relay.exe
