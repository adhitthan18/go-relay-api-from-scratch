PORT=8090

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=relay
DB_NAME=belajar_relay
DB_PASSWORD=

ADMIN_EMAIL=
ADMIN_PASSWORD=

BOOTSTRAP_KEY=

# Nginx berjalan di mesin yang sama. Kalau nanti dipasang di belakang
# Cloudflare, rentang alamat Cloudflare harus ikut ditambahkan di sini —
# kalau tidak, semua pengguna terhitung sebagai satu alamat.
TRUSTED_PROXIES=127.0.0.1,::1

# COOKIE_SECURE sengaja tidak diisi. Defaultnya true, dan di server yang
# memang HTTPS itu yang benar.